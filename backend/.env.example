# ─────────────────────────────────────────────────────────────
# Venner-Hisab Backend — Environment Variables Template
# Copy this file to .env and fill in your local values.
# NEVER commit .env to Git.
# ─────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
# Local PostgreSQL (development)
DATABASE_URL=postgresql://venner_user:venner_pass@localhost:5432/venner_hisab_dev

# ── App Secrets ───────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-64-char-random-hex-string

# ── Session Config ────────────────────────────────────────────
# Session token TTL in seconds (default: 8 hours = 28800)
SESSION_TTL_SECONDS=28800

# ── Environment ───────────────────────────────────────────────
# "development" or "production"
ENVIRONMENT=development

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── File Uploads ──────────────────────────────────────────────
UPLOAD_DIR=./data/uploads
